+    private enum VocivoCallKitIdentity {
+        static func resolve(displayName: String, address: String) -> (handle: CXHandle, name: String, address: String) {
+            let cleanName = cleanLabel(displayName)
+            let cleanAddress = address.trimmingCharacters(in: .whitespacesAndNewlines)
+            let phoneAddress = cleanAddress.replacingOccurrences(of: " ", with: "")
+            let isPhone = phoneAddress.range(of: #"^\+?[0-9*#]{3,20}$"#, options: .regularExpression) != nil
+            let fallback = cleanLabel(cleanAddress)
+            let label = cleanName.isEmpty ? (fallback.isEmpty ? "Vocivo caller" : fallback) : cleanName
+            let handle = isPhone
+                ? CXHandle(type: .phoneNumber, value: phoneAddress)
+                : CXHandle(type: .generic, value: label)
+            return (handle, label, isPhone ? phoneAddress : label)
+        }
+
+        private static func cleanLabel(_ raw: String) -> String {
+            var value = raw.replacingOccurrences(of: "[\\r\\n\\t]", with: " ", options: .regularExpression)
+                .trimmingCharacters(in: .whitespacesAndNewlines)
+            if let quoted = value.range(of: #"^\s*\"([^\"]+)\""#, options: .regularExpression) {
+                value = String(value[quoted]).replacingOccurrences(of: "\"", with: "")
+            } else if let bracket = value.firstIndex(of: "<") {
+                value = String(value[..<bracket]).trimmingCharacters(in: .whitespacesAndNewlines)
+            }
+            if value.lowercased().hasPrefix("sip:") || value.contains("@") {
+                return ""
+            }
+            value = value.replacingOccurrences(of: #"\s+"#, with: " ", options: .regularExpression)
+            return String(value.prefix(80))
+        }
+    }
