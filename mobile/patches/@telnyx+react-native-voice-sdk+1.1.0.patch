@@ -508,0 +509,28 @@ export class Call extends EventEmitter<CallEvents> {
+  /**
+   * Restart ICE and renegotiate the active Telnyx media dialog after a network
+   * interface migration. The attach transaction is Telnyx's supported
+   * re-INVITE equivalent and carries the fresh SDP offer to the gateway.
+   */
+  public restartMedia = async () => {
+    if (!this.peer) throw new Error('[Call] Peer is not created');
+    const peerConnection = this.peer.getPeerConnection();
+    if (!peerConnection) throw new Error('[Call] Peer connection is unavailable');
+    peerConnection.restartIce();
+    await this.peer.createOffer({ iceRestart: true });
+    const response = await this.connection.sendAndWait(
+      createAttachMessage({
+        callId: this.callId,
+        sessionId: this.sessionId,
+        sdp: this.getLocalSdpForSignaling(),
+        customHeaders: this.inviteCustomHeaders || [],
+        destinationNumber: this.options.destinationNumber || '',
+        callerIdName: this.options.callerIdName || '',
+        callerIdNumber: this.options.callerIdNumber || '',
+        clientState: this.options.clientState || '',
+        userVariables: [],
+      })
+    );
+    if (!response || typeof response !== 'object') throw new Error('[Call] Invalid media restart acknowledgment');
+    if (this.isTrickleIceEnabled()) this.peer.flushPendingLocalCandidates();
+  };
