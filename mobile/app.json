{
  "expo": {
    "name": "Vocivo",
    "slug": "vocivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/vocivo-icon.png",
    "scheme": "vocivo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vocivo.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Vocivo may use your camera for compatible calling features when you grant permission.",
        "NSContactsUsageDescription": "Vocivo uses your contacts so you can quickly call or message people you choose.",
        "NSMicrophoneUsageDescription": "Vocivo uses your microphone for voice calls.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "65"
    },
    "android": {
      "package": "app.vocivo.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/vocivo-icon.png",
        "backgroundColor": "#07111F"
      },
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.WAKE_LOCK",
        "READ_CONTACTS",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_PHONE_NUMBERS"
      ],
      "versionCode": 65
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Vocivo uses your contacts so you can quickly call or message people you choose."
        }
      ],
      "./plugins/withTelnyxVoip",
      "./plugins/withVocivoSip",
      "./plugins/withFmtXcode26",
      "./plugins/withQuotedBundlePath",
      "./plugins/withScriptSandboxingOff",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/vocivo-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-localization",
      "expo-asset"
    ],
    "owner": "mousaothman",
    "extra": {
      "eas": {
        "projectId": "3e0a713b-7f14-45a2-9788-9c9bf145cfd8"
      }
    }
  }
}
