VOCIVO_SIP_REALM=sip.vocivo.app
VOCIVO_SIP_DOMAIN=sip.vocivo.app
VOCIVO_SIP_WSS_URI=wss://sip.vocivo.app/ws
VOCIVO_API_URL=https://vocivo.app
SIP_EDGE_SECRET=replace-with-a-long-shared-secret
TELNYX_SIP_HOST=sip.telnyx.com
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
TELNYX_SIP_REALM=sip.telnyx.com
PUBLIC_IP=127.0.0.1
RTP_START=16384
RTP_END=16484
# 1 = FreeSWITCH fetches the inbound dialplan from the Vocivo API (voice menus,
# ring groups, queues, voicemail). Must match VOCIVO_SIP_INBOUND on Vercel.
VOCIVO_SIP_INBOUND=0
# Scratch space for voicemail recordings between `record` and `http_put`.
VOCIVO_SIP_RECORDINGS_DIR=/var/lib/vocivo/recordings
