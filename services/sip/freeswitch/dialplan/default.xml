<include>
  <context name="default">
    <extension name="vocivo-conference">
      <condition field="destination_number" expression="^conf-([A-Za-z0-9_-]+)$">
        <action application="answer"/>
        <action application="conference" data="$1@default"/>
      </condition>
    </extension>
    <extension name="vocivo-internal-aor">
      <condition field="destination_number" expression="^([A-Za-z0-9_.-]{2,64})$">
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="bridge" data="sofia/external/${destination_number}@127.0.0.1:5060"/>
      </condition>
    </extension>
    <extension name="vocivo-pstn-telnyx">
      <condition field="destination_number" expression="^\+?([1-9]\d{6,14})$">
        <action application="set" data="effective_caller_id_number=${outbound_caller_id_number}"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <!-- The carrier leg's call record has to say whose call it was: the
             route the API issued for it names the tenant and the caller. -->
        <action application="export" data="nolocal:vocivo_route_token=${sip_h_X-Vocivo-Route-Token}"/>
        <action application="export" data="nolocal:vocivo_flow=outbound"/>
        <action application="bridge" data="sofia/gateway/telnyx/+$1"/>
      </condition>
    </extension>
  </context>
</include>
