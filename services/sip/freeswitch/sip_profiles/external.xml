<!-- The Kamailio-facing side of FreeSWITCH: bound to loopback, so the switch
     cannot be reached from the internet. The carrier gateway is on the `trunk`
     profile, which is the one bound to the public address. -->
<profile name="external">
  <settings>
    <param name="sip-port" value="5080"/>
    <param name="dialplan" value="XML"/>
    <param name="context" value="public"/>
    <param name="auth-calls" value="false"/>
    <param name="rtp-ip" value="0.0.0.0"/>
    <param name="sip-ip" value="127.0.0.1"/>
    <param name="ext-rtp-ip" value="$${PUBLIC_IP}"/>
    <param name="ext-sip-ip" value="$${PUBLIC_IP}"/>
    <param name="inbound-codec-prefs" value="OPUS,PCMU,PCMA"/>
    <param name="outbound-codec-prefs" value="OPUS,PCMU,PCMA"/>
    <param name="manage-presence" value="false"/>
    <param name="sip-trace" value="no"/>
  </settings>
</profile>
