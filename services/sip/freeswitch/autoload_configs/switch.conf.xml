<configuration name="switch.conf" description="Vocivo FreeSWITCH core">
  <settings>
    <param name="colorize-logging" value="true"/>
    <param name="max-sessions" value="200"/>
    <param name="sessions-per-second" value="20"/>
    <!-- Two ports per leg, two legs per call: this is 1,250 calls, not 25. -->
    <param name="rtp-start-port" value="20000"/>
    <param name="rtp-end-port" value="24999"/>
  </settings>
</configuration>
