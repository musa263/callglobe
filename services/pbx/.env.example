# FreeSWITCH host identity
FREESWITCH_VERSION=v1.11.1
PBX_PUBLIC_IP=203.0.113.10
# DigitalOcean anchor IPv4 used by the carrier-facing Sofia profile.
PBX_CARRIER_BIND_IP=10.0.0.2
PBX_SIP_DOMAIN=sip.example.com
PBX_WSS_DOMAIN=sip-wss.example.com
PBX_VERTO_DOMAIN=verto.example.com
PBX_DEFAULT_EXTENSION=2000
PBX_DEFAULT_EXTENSION_NAME=Vocivo Administrator
PBX_DEFAULT_EXTENSION_PASSWORD=replace-with-a-long-random-password
PBX_RTP_START=20000
PBX_RTP_END=29999
PBX_MAX_SESSIONS=50
PBX_SESSIONS_PER_SECOND=10
TLS_CONTACT_EMAIL=operations@example.com

# Keep ESL private. Use a different random value in every environment.
ESL_PASSWORD=replace-with-at-least-32-random-characters
VOCIVO_EVENT_WEBHOOK_URL=https://vocivo.vercel.app/api/voice/pbx-events
VOCIVO_DEVICE_RESOLVER_URL=https://vocivo.vercel.app/api/voice/pbx-devices
VOCIVO_DIRECTORY_SNAPSHOT_URL=https://vocivo.vercel.app/api/voice/pbx-directory
VOCIVO_DIRECTORY_REFRESH_MS=60000
VOCIVO_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# PSTN trunk. Telnyx can be replaced with GO Telecom when its SIP details are ready.
PSTN_GATEWAY_NAME=telnyx
PSTN_SIP_PROXY=sip.telnyx.com
PSTN_SIP_PORT=5060
PSTN_SIP_USERNAME=replace-me
PSTN_SIP_PASSWORD=replace-me
PSTN_OUTBOUND_CALLER_ID=+18447161777
PSTN_REGISTER=true

# APNs VoIP push. Mount the .p8 key read-only at this path on the server.
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=app.vocivo.mobile
APNS_KEY_PATH=/run/secrets/apns-auth-key.p8
APNS_ENVIRONMENT=production

# Android FCM HTTP v1. Mount the service-account JSON at this path.
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# Optional direct device list for a private smoke test. Production resolves
# registered devices through VOCIVO_DEVICE_RESOLVER_URL.
PUSH_TEST_DEVICES_JSON=[]
