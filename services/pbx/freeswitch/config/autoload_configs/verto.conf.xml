<configuration name="verto.conf" description="Vocivo Verto WebRTC">
  <settings>
    <param name="debug" value="0"/>
    <param name="enable-presence" value="true"/>
    <param name="enable-fs-events" value="false"/>
  </settings>
  <profiles>
    <profile name="vocivo-v4">
      <param name="bind-local" value="127.0.0.1:8081"/>
      <param name="force-register-domain" value="@@PBX_SIP_DOMAIN@@"/>
      <param name="context" value="vocivo-internal"/>
      <param name="apply-candidate-acl" value="wan.auto"/>
      <param name="apply-candidate-acl" value="localnet.auto"/>
      <param name="rtp-ip" value="@@PBX_PUBLIC_IP@@"/>
      <param name="ext-rtp-ip" value="@@PBX_PUBLIC_IP@@"/>
      <param name="local-network" value="localnet.auto"/>
      <param name="outbound-codec-string" value="opus,PCMU,PCMA"/>
      <param name="inbound-codec-string" value="opus,PCMU,PCMA"/>
    </profile>
  </profiles>
</configuration>
