<include>
  <context name="public">
    <extension name="carrier-inbound">
      <condition field="destination_number" expression="^(\+?[0-9]{7,15})$">
        <action application="set" data="vocivo_call_id=${uuid}"/>
        <action application="set" data="domain_name=@@PBX_SIP_DOMAIN@@"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=true"/>
        <action application="export" data="nolocal:vocivo_call_type=external"/>
        <action application="export" data="nolocal:vocivo_call_id=${vocivo_call_id}"/>
        <action application="export" data="nolocal:vocivo_organization_id=primary"/>
        <action application="export" data="nolocal:vocivo_inbound_number=$1"/>
        <action application="export" data="nolocal:vocivo_push_target_extension=@@PBX_DEFAULT_EXTENSION@@"/>
        <action application="export" data="nolocal:vocivo_caller_name=${caller_id_name}"/>
        <action application="export" data="nolocal:vocivo_caller_number=${caller_id_number}"/>
        <action application="export" data="nolocal:sip_h_X-Vocivo-Call-UUID=${vocivo_call_id}"/>
        <action application="export" data="nolocal:sip_h_X-Vocivo-Call-Type=external"/>
        <action application="export" data="nolocal:sip_h_X-Vocivo-Caller-Name=${caller_id_name}"/>
        <action application="bridge" data="user/@@PBX_DEFAULT_EXTENSION@@&#64;@@PBX_SIP_DOMAIN@@"/>
        <action application="voicemail" data="default @@PBX_SIP_DOMAIN@@ @@PBX_DEFAULT_EXTENSION@@"/>
      </condition>
    </extension>

    <extension name="reject-unrouted-public-call">
      <condition field="destination_number" expression="^.*$">
        <action application="respond" data="404 Number not assigned"/>
      </condition>
    </extension>
  </context>
</include>
