<include>
  <!-- Production DID routes are generated from the signed tenant snapshot by
       the local /dialplan xml_curl service. This static context is fail-closed
       for maintenance mode and must never select a default organization. -->
  <context name="public">
    <extension name="reject-unscoped-carrier-inbound">
      <condition field="destination_number" expression="^(\+?[0-9]{7,15})$">
        <action application="set" data="vocivo_call_id=${uuid}"/>
        <action application="log" data="WARNING Rejecting inbound DID without a generated tenant route: $1"/>
        <action application="respond" data="503 Tenant route not provisioned"/>
      </condition>
    </extension>

    <extension name="reject-unrouted-public-call">
      <condition field="destination_number" expression="^.*$">
        <action application="respond" data="404 Number not assigned"/>
      </condition>
    </extension>
  </context>
</include>
