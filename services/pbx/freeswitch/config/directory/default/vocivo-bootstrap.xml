<include>
  <domain name="@@PBX_SIP_DOMAIN@@">
    <params>
      <param name="dial-string" value="{presence_id=${dialed_user}@${dialed_domain},domain_name=${dialed_domain}}${sofia_contact(${dialed_user}@${dialed_domain})}"/>
      <param name="jsonrpc-allowed-methods" value="verto"/>
    </params>
    <variables>
      <variable name="record_stereo" value="true"/>
      <variable name="default_gateway" value="@@PSTN_GATEWAY_NAME@@"/>
      <variable name="default_areacode" value=""/>
      <variable name="transfer_fallback_extension" value="operator"/>
    </variables>
    <groups>
      <group name="default">
        <users>
          <user id="@@PBX_DEFAULT_EXTENSION@@">
            <params>
              <param name="password" value="@@PBX_DEFAULT_EXTENSION_PASSWORD@@"/>
              <param name="vm-password" value="@@PBX_DEFAULT_EXTENSION@@"/>
            </params>
            <variables>
              <variable name="user_context" value="vocivo-internal"/>
              <variable name="effective_caller_id_name" value="@@PBX_DEFAULT_EXTENSION_NAME@@"/>
              <variable name="effective_caller_id_number" value="@@PBX_DEFAULT_EXTENSION@@"/>
              <variable name="outbound_caller_id_name" value="@@PBX_DEFAULT_EXTENSION_NAME@@"/>
              <variable name="outbound_caller_id_number" value="@@PSTN_OUTBOUND_CALLER_ID@@"/>
              <variable name="vocivo_organization_id" value="primary"/>
            </variables>
          </user>
        </users>
      </group>
    </groups>
  </domain>
</include>
