# Keep the regulated carrier configuration until its replacement is active.
PSTN_GATEWAY_NAME=telnyx
PSTN_SIP_PROXY=sip.telnyx.com
PSTN_SIP_PORT=5060
PSTN_SIP_USERNAME=REPLACE_WITH_CARRIER_USERNAME
PSTN_SIP_PASSWORD=REPLACE_WITH_CARRIER_PASSWORD
PSTN_OUTBOUND_CALLER_ID=+18447161777
PSTN_REGISTER=true

# Production deployment intentionally fails closed when either push credential
# is absent. Never disable these flags to make a failed deployment pass.
APNS_ENABLED=true
APNS_TEAM_ID=5W8SW6RXH6
APNS_KEY_ID=4SUUVBZ7R9
APNS_BUNDLE_ID=app.vocivo.mobile
APNS_KEY_PATH=/run/secrets/apns-auth-key.p8
APNS_ENVIRONMENT=production
APNS_MAX_CONCURRENCY=32
APNS_MAX_QUEUE=5000
FCM_ENABLED=true
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

TURN_REALM=turn.68.183.244.215.nip.io
TURN_TLS_DOMAIN=turn.68.183.244.215.nip.io
TURN_AUTH_SECRET_FILE=./secrets/turn-auth-secret
