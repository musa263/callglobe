{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/" },
    { "source": "/api/storage", "destination": "/api/platform/storage" },
    { "source": "/api/health", "destination": "/api/platform/health" }
  ]
}
