# Only public browser configuration belongs here.
VITE_APP_URL=http://localhost:5173

# Configure authentication, Telnyx, storage, and webhook secrets in Vercel.
# See frontend/docs/SETUP_GUIDE.md for the server environment list.
# Optional Telnyx-provided ICE configuration. TURN entries require short-lived
# username and credential values; never place permanent TURN secrets here.
TELNYX_ICE_SERVERS_JSON=
# Server-only Vocivo relay settings. Set these together in Vercel, never VITE_*.
# The secret must equal TURN_SECRET on the coturn host; keep real secrets out of Git.
VOCIVO_TURN_URLS=
VOCIVO_TURN_SECRET=

# Browser Push API credentials. Generate one VAPID key pair and store the
# private key only in Vercel server environment variables.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:security@vocivo.com
