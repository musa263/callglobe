# Only public browser configuration belongs here.
VITE_APP_URL=http://localhost:5173

# Configure authentication, Telnyx, storage, and webhook secrets in Vercel.
# See frontend/docs/SETUP_GUIDE.md for the server environment list.
# Comma-separated STUN and TURN URLs used by authenticated WebRTC clients.
VOCIVO_STUN_URLS=stun:stun.cloudflare.com:3478
VOCIVO_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
VOCIVO_TURN_SECRET=REPLACE_WITH_THE_PBX_TURN_AUTH_SECRET
VOCIVO_TURN_TTL_SECONDS=600
